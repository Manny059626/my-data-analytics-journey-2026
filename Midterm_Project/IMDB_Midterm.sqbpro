<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="IMDB_Midterm.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1591"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="IMDB_Clean" custom_title="0" dock_id="1" table="4,10:mainIMDB_Clean"/><dock_state state="000000ff00000000fd00000001000000020000039100000258fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003910000013500ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="IMDB_Clean" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="82"/><column index="2" value="300"/><column index="3" value="87"/><column index="4" value="239"/><column index="5" value="57"/><column index="6" value="103"/><column index="7" value="93"/><column index="8" value="263"/><column index="9" value="87"/><column index="10" value="63"/><column index="11" value="40"/><column index="12" value="46"/><column index="13" value="46"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT COUNT(*) AS Total_Movies
FROM IMDB_Clean;

SELECT *
FROM IMDB_Clean;

DELETE FROM IMDB_Clean
WHERE &quot;IMBD Title ID&quot; IS NULL;

SELECT COUNT(*) AS Total_Movies
FROM IMDB_Clean;

SELECT Country,
       COUNT(*) AS Movie_Count
FROM IMDB_Clean
GROUP BY Country
ORDER BY Movie_Count DESC;

SELECT Country,
       ROUND(AVG(Score), 2) AS Average_Rating
FROM IMDB_Clean
GROUP BY Country
ORDER BY Average_Rating DESC;

SELECT &quot;Original Title&quot;,
       Score
FROM IMDB_Clean
ORDER BY Score DESC
LIMIT 10;

SELECT Country,
       SUM(Income) AS Total_Income
FROM IMDB_Clean
GROUP BY Country
ORDER BY Total_Income DESC;

SELECT &quot;Original Title&quot;,
       Votes
FROM IMDB_Clean
ORDER BY Votes DESC
LIMIT 10;

SELECT Director,
       ROUND(AVG(Score),2) AS Average_Rating,
       COUNT(*) AS Movie_Count
FROM IMDB_Clean
GROUP BY Director
HAVING COUNT(*) &gt;= 2
ORDER BY Average_Rating DESC;


</sql><current_tab id="0"/></tab_sql></sqlb_project>
